# MongoDB Connection String (Atlas Replica Set)
DATABASE_URL="mongodb+srv://<username>:<password>@<your-cluster-url>.mongodb.net/CTF?retryWrites=true&w=majority"

# JWT Secret & Expiration
JWT_SECRET="your-super-strong-jwt-secret-here"
JWT_EXPIRES_IN="24h"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Frontend Origin URL for CORS (e.g. http://localhost:5173 or https://your-ctf.vercel.app)
FRONTEND_URL="http://localhost:5173"
