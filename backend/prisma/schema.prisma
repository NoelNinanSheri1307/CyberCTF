// This is your Prisma schema file, configured for MongoDB.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- CORE MODELS ---

model Team {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String     @unique
  passwordHash String
  isAdmin      Boolean    @default(false)
  users        User[] 
  solves       Solve[]
  hintUnlocks  HintUnlock[]
  createdAt    DateTime   @default(now())
  teamScore    TeamScore? // one-to-one relation back
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  
  teamId    String   @db.ObjectId
  team      Team     @relation(fields: [teamId], references: [id])
}

model Round {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  startTime  DateTime
  endTime    DateTime
  challenges Challenge[]
}

model Challenge {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  category    String
  difficulty  String
  points      Int
  flagHash    String
  hints       Hint[]
  solves      Solve[]
  resourceUrl String?
  
  roundId     String?  @db.ObjectId
  round       Round?   @relation(fields: [roundId], references: [id])
}

model Hint {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  text            String
  pointsDeduction Int
  unlockedBy      HintUnlock[]
  
  challengeId     String       @db.ObjectId
  challenge       Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}


// --- LOGGING & TRACKING MODELS ---

model HintUnlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  
  teamId    String   @db.ObjectId
  hintId    String   @db.ObjectId
  team      Team     @relation(fields: [teamId], references: [id])
  hint      Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([teamId, hintId])
}

model Solve {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime  @default(now())
  
  teamId      String    @db.ObjectId
  challengeId String    @db.ObjectId
  team        Team      @relation(fields: [teamId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([teamId, challengeId])
}

model TeamScore {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId    String   @unique @db.ObjectId
  points    Int      @default(0)
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id])
}
